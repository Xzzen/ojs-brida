# Salin ke .env.local jika ingin menguji lokal mengarah ke backend cloud,
# atau masukkan ke Environment Variables di Dashboard Vercel / Netlify:

# URL API Backend Laravel Anda di Render (akhiri dengan /api, tanpa slash penutup)
VITE_API_BASE=https://NAMA-BACKEND-ANDA.onrender.com/api

# Opsional: URL dasar storage lokal backend (untuk file cloud Supabase, URL sudah otomatis lengkap dari backend)
# VITE_STORAGE_BASE=https://NAMA-BACKEND-ANDA.onrender.com/storage/
