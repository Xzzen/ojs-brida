# ==============================================================================
# CONTOH ENVIRONMENT VARIABLES CLOUD (RENDER + AIVEN MYSQL + SUPABASE STORAGE)
# Salin variabel di bawah ke menu Environment di Dashboard Render Anda
# ==============================================================================

APP_NAME="OJS BRIDA Makassar"
APP_ENV=production
APP_DEBUG=false
# Generate dengan: php artisan key:generate --show
APP_KEY=base64:ISI_DENGAN_HASIL_KEY_GENERATE
APP_URL=https://NAMA-BACKEND-ANDA.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- 1. CLOUD DATABASE (AIVEN FOR MYSQL / TIDB CLOUD) ---
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=ISI_PASSWORD_DB_AIVEN
# Aktifkan SSL untuk Aiven / TiDB Cloud:
DB_SSL_MODE=REQUIRED
DB_SSL_VERIFY=false
# (Opsional) Jika ingin verifikasi CA cert ketat, tempel isi ca.pem Aiven di sini:
# MYSQL_ATTR_SSL_CA_CONTENT=

# --- 2. CLOUD STORAGE UNTUK PDF & DOCX (SUPABASE STORAGE - GRATIS 1GB) ---
# Ambil dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://PROJECT-ID-ANDA.supabase.co
SUPABASE_SERVICE_KEY=ISI_SERVICE_ROLE_SECRET_KEY_SUPABASE
SUPABASE_BUCKET=manuscripts

# --- 3. CORS & STARTUP ---
# Gunakan "*" atau isi URL Vercel Anda (mis. https://ojs-brida.vercel.app)
CORS_ALLOWED_ORIGINS=*
AUTO_MIGRATE=true
